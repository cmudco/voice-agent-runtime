MISTRAL_API_KEY=

# Comma-separated list of Socratic Books backends this runtime serves. One
# runtime can front several environments (e.g. staging + prod); each session is
# routed to the backend that owns it. The singular SOCRATIC_BOTS_BACKEND_URL is
# still accepted as a fallback.
SOCRATIC_BOTS_BACKEND_URLS=http://localhost:8001
DARE_INTERNAL_KEY=
VOICE_RUNTIME_SESSION_SECRET=

VOICE_RUNTIME_ICE_SERVERS=stun:stun.l.google.com:19302
VOICE_RUNTIME_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
VOICE_RUNTIME_LOG_TTS_REQUEST_TEXT=false

MISTRAL_LLM_MODEL=mistral-large-latest
MISTRAL_LLM_MAX_TOKENS=180
MISTRAL_STT_MODEL=voxtral-mini-transcribe-realtime-2602
MISTRAL_STT_TARGET_DELAY_MS=600
MISTRAL_TTS_MODEL=voxtral-mini-tts-2603
MISTRAL_TTS_VOICE=en_paul_neutral

# TTS engine + transport. kokoro + webrtc is the tested production
# configuration: local English-pinned Kokoro streamed over the WebRTC track,
# in sync with the transcript events. The code defaults are mistral + http
# (buffered Voxtral WAVs over HTTP, kept as a fallback for older deployments),
# so set both explicitly. "webrtc" is only valid with the kokoro engine.
# Leave KOKORO_*_PATH empty to auto-download the ONNX model on first use.
VOICE_RUNTIME_TTS_PROVIDER=kokoro
VOICE_RUNTIME_TTS_TRANSPORT=webrtc
KOKORO_VOICE=af_heart
KOKORO_MODEL_PATH=
KOKORO_VOICES_PATH=

# Silero VAD. confidence = model speech-probability threshold; min_volume = a
# raw energy gate applied on top of the model. Both were 0.7 / 0.6, which was
# too strict and forced students to speak loudly/close to the mic. Lowered so
# normal conversational voice at a normal distance is captured cleanly.
VOICE_RUNTIME_VAD_CONFIDENCE=0.5
VOICE_RUNTIME_VAD_START_SECS=0.2
VOICE_RUNTIME_VAD_STOP_SECS=1.2
VOICE_RUNTIME_VAD_MIN_VOLUME=0.35

# Caps Pipecat's fallback wait after the student stops talking. Lower feels
# snappier; higher is more patient with long thinking pauses.
VOICE_RUNTIME_USER_TURN_STOP_TIMEOUT=2.0

# Debug switch — keep off in production.
# VOICE_RUNTIME_LLM_INPUT_DEBUG dumps each LLM request context (including
# student answers) to /tmp/voice-runtime-audio/<session>/.
VOICE_RUNTIME_LLM_INPUT_DEBUG=false
