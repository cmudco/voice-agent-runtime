MISTRAL_API_KEY=

# Comma-separated list of Socratic Bots backends this runtime serves. One
# runtime can front several environments (e.g. staging + prod); each session is
# routed to the backend that owns it. The singular SOCRATIC_BOTS_BACKEND_URL is
# still accepted as a fallback.
SOCRATIC_BOTS_BACKEND_URLS=http://localhost:8001
DARE_INTERNAL_KEY=
VOICE_RUNTIME_SESSION_SECRET=

VOICE_RUNTIME_ICE_SERVERS=stun:stun.l.google.com:19302
VOICE_RUNTIME_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
VOICE_RUNTIME_LOG_TTS_REQUEST_TEXT=false

MISTRAL_LLM_MODEL=mistral-large-latest
MISTRAL_LLM_MAX_TOKENS=180
MISTRAL_STT_MODEL=voxtral-mini-transcribe-realtime-2602
MISTRAL_STT_TARGET_DELAY_MS=600
MISTRAL_TTS_MODEL=voxtral-mini-tts-2603
MISTRAL_TTS_VOICE=en_paul_neutral

# TTS engine + transport. kokoro + webrtc is the tested production
# configuration: local English-pinned Kokoro streamed over the WebRTC track,
# in sync with the transcript events. The code defaults are mistral + http
# (buffered Voxtral WAVs over HTTP, kept as a fallback for older deployments),
# so set both explicitly. "webrtc" is only valid with the kokoro engine.
# Leave KOKORO_*_PATH empty to auto-download the ONNX model on first use.
VOICE_RUNTIME_TTS_PROVIDER=kokoro
VOICE_RUNTIME_TTS_TRANSPORT=webrtc
KOKORO_VOICE=af_heart
KOKORO_MODEL_PATH=
KOKORO_VOICES_PATH=

# Silero VAD. confidence = model speech-probability threshold; min_volume = a
# raw energy gate applied on top of the model. Both were 0.7 / 0.6, which was
# too strict and forced students to speak loudly/close to the mic. Lowered so
# normal conversational voice at a normal distance is captured cleanly.
VOICE_RUNTIME_VAD_CONFIDENCE=0.5
VOICE_RUNTIME_VAD_START_SECS=0.2
VOICE_RUNTIME_VAD_STOP_SECS=1.2
VOICE_RUNTIME_VAD_MIN_VOLUME=0.35

# Caps Pipecat's fallback wait after the student stops talking. Lower feels
# snappier; higher is more patient with long thinking pauses.
VOICE_RUNTIME_USER_TURN_STOP_TIMEOUT=2.0

# Debug switch — keep off in production.
# VOICE_RUNTIME_LLM_INPUT_DEBUG dumps each LLM request context (including
# student answers) to /tmp/voice-runtime-audio/<session>/.
VOICE_RUNTIME_LLM_INPUT_DEBUG=false
# Inbound mic-level telemetry: logs audio levels only, never speech content.
# The code default is true (it is the main way to tell a silent browser track
# from speech dropped below the VAD gate). Set false unless you are debugging
# microphone problems; it is noisy in the logs.
VOICE_RUNTIME_AUDIO_INPUT_DEBUG=false

# Sentry — leave SENTRY_DSN empty to disable. SENTRY_ENVIRONMENT names the
# runtime deployment; events are also tagged with the backend host that owns
# each session (one runtime fronts staging + prod).
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
# Brain fallback. The agent's chosen model (or MISTRAL_LLM_MODEL) is tried
# first; on any error or no first token within the TTFB deadline the next
# model answers the turn. Models whose provider key is missing are skipped.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
VOICE_RUNTIME_LLM_FALLBACKS=gpt-5.6-luna,claude-haiku-4-5-20251001,mistral-large-latest
VOICE_RUNTIME_LLM_TTFB_DEADLINE_SECS=6.0
VOICE_RUNTIME_LLM_RESPONSE_TIMEOUT_SECS=30.0
# Optional self-hosted STT backup. Both values are required to enable it.
# Start the isolated worker first; do not expose its port publicly.
VOICE_RUNTIME_WHISPER_URL=
VOICE_RUNTIME_WHISPER_TOKEN=
VOICE_RUNTIME_STT_PROGRESS_TIMEOUT_SECS=12
VOICE_RUNTIME_STT_RECONNECT_TIMEOUT_SECS=12
# The reconnect wait grows with the replayed clip length, up to this cap.
VOICE_RUNTIME_STT_RECONNECT_CAP_SECS=30
# Seconds allowed between VAD closing a user turn and the first transcript
# before the Mistral STT socket is presumed dead and rebuilt with a replay.
# <= 0 disables the watchdog. Must stay positive when the Whisper backup is on.
VOICE_RUNTIME_STT_LIVENESS_DEADLINE_SECS=4.0
# Development uses only this explicit local-testing DSN, never SENTRY_DSN.
LOCAL_SENTRY_DSN=

# ---------------------------------------------------------------------------
# Whisper worker (separate process)
# ---------------------------------------------------------------------------
# Read only by runtime.whisper_worker, which runs in its own virtualenv
# (requirements-whisper.txt) on loopback, e.g. 127.0.0.1:8011. The runtime
# itself ignores these. The worker also needs VOICE_RUNTIME_WHISPER_TOKEN
# exported in its environment. See docs/how-to/whisper-backup.md.
# WHISPER_MODEL=small          # model name or local model directory
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8
# WHISPER_CPU_THREADS=4
